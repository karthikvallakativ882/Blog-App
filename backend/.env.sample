# Copy this file to .env and replace placeholder values with real secrets
PORT=5000
# MongoDB connection (replace <password> and remove surrounding quotes)
DB_URL="mongodb+srv://<db_user>:<password>@cluster0.82xonkg.mongodb.net/<dbname>?retryWrites=true&w=majority"
# Alternatively, set MONGO_URI if you prefer
# MONGO_URI="mongodb+srv://<db_user>:<password>@cluster0.82xonkg.mongodb.net/<dbname>?retryWrites=true&w=majority"

JWT_SECRET=your_jwt_secret_here

# Comma-separated list of allowed client origins for CORS (used by server.js)
# Example: http://localhost:5173,https://blog-app-f.vercel.app,https://blog-app-bmma.vercel.app
# Wildcards are supported, e.g. https://*.vercel.app
CLIENT_URLS=http://localhost:5173

# Alternatively, set a single origin with CLIENT_URL
# CLIENT_URL=https://blog-app-f.vercel.app

# Cloudinary credentials (required for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
